# =====================================================================
# TrustVault Environment Configuration Example
# Copy this file to .env and fill in real values for your environment.
# NEVER commit real secrets or production credentials to source control.
# =====================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS allowed origins)
CORS_ORIGIN=http://localhost:5173

# Database Connection
# PostgreSQL connection string: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://trustvault_user:trustvault_password@localhost:5432/trustvault_db

# JWT & Authentication Secret
# Minimum 32-character high-entropy random string
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=1h

# File Storage Configuration
# Files are stored outside public static directories with sanitized UUID names
STORAGE_DIR=storage/uploads
MAX_FILE_SIZE_BYTES=10485760 # 10MB

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# Audit Anchor / Checkpoint Secret (optional external HMAC anchor for audit verification)
AUDIT_HMAC_SECRET=replace_with_an_audit_anchor_hmac_secret_at_least_32_chars
