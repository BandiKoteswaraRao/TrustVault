# =====================================================================
# TrustVault — Environment Configuration Template
# Copy this file to .env and configure for your deployment environment.
# =====================================================================

# Server Port (Render sets this dynamically)
PORT=8080

# Active Spring Profile: 'default' (H2 in-memory), 'mysql' (Docker/local), or 'postgres'/'supabase'
SPRING_PROFILES_ACTIVE=default

# BCrypt Work Factor (10-14 recommended for production)
TRUSTVAULT_SECURITY_BCRYPT_STRENGTH=12

# Local Storage Directory (Fallback when Supabase Storage is not configured)
TRUSTVAULT_STORAGE_UPLOAD_DIR=storage/uploads

# ---------------------------------------------------------------------
# Supabase PostgreSQL Connection (Required if SPRING_PROFILES_ACTIVE=postgres or supabase)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# ---------------------------------------------------------------------
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_STRONG_SUPABASE_PASSWORD

# ---------------------------------------------------------------------
# Supabase Storage Integration (Private Bucket)
# Found in Supabase Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------
# Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service Role Secret Key (Server-side ONLY; NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Private Storage Bucket Name
SUPABASE_STORAGE_BUCKET=trustvault-documents
